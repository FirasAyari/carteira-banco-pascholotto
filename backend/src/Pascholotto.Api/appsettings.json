{
  "ConnectionStrings": {
    "PascholottoDb": "Server=(localdb)\\MSSQLLocalDB;Database=PascholottoMvp;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "Pascholotto.Api",
    "Audience": "Pascholotto.Frontend",
    "SigningKey": "pascholotto-super-secret-key-for-mvp-dotnet-10",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "App": {
    "UseHttpsRedirection": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
